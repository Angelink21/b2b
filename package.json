{
  "name": "fagor-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "images:sync": "tsx scripts/sync-images.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lhci": "node scripts/lighthouse-ci.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "nuqs": "2.10.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
