# Public site URL (canonical / sitemap / absolute links)
# Local default. Production (when DNS switches): https://fagorlaundry.com.ua
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead sinks — comma-separated: console, email, telegram, webhook
# Local/dev without Resend: console. Production with mail: email
LEADS_SINKS=console

# Anti-spam
LEADS_RATE_SALT=change-me-in-production
# Minimum form fill time in ms (e2e can set 0)
LEADS_MIN_FILL_MS=3000
# Max submissions per IP hash per window
LEADS_RATE_LIMIT_MAX=8
LEADS_RATE_LIMIT_WINDOW_MS=3600000

# Email sink (Resend) — required when LEADS_SINKS includes email
# RESEND_API_KEY=
# FROM must be a Resend-verified domain (or beth.t@example.com for tests)
# LEADS_EMAIL_FROM=quotes@fagorlaundry.com.ua
# TO defaults to siteConfig.email (pkmprofessional@ukr.net) when unset
# LEADS_EMAIL_TO=

# Telegram sink — required when LEADS_SINKS includes telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Webhook sink (HMAC-SHA256 in X-Fagor-Signature) — required when includes webhook
# LEADS_WEBHOOK_URL=https://example.com/hooks/leads
# LEADS_WEBHOOK_SECRET=

# Optional distributed rate limit (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional Cloudflare Turnstile (both required to enable)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: enable /_styleguide in production
# ENABLE_STYLEGUIDE=1

# Catalog CSV from published Google Sheet (File → Share → Publish to web → CSV).
# Without this, catalog:build reads data/products_clean.csv;
# runtime getCatalog() serves the build snapshot.
# Do not commit the real URL. Never put secrets in the sheet.
# CATALOG_CSV_URL=
# Allow catalog model count to drop below 80% of the previous build snapshot
# CATALOG_ALLOW_SHRINK=1
# Runtime cache lifetime for getCatalog() (seconds). Production default: 300.
# CATALOG_CACHE_REVALIDATE_SECONDS=300
# Optional Bearer secret for GET /api/catalog-status (404 when unset).
# CATALOG_STATUS_SECRET=

# Cloudinary model photos (public delivery only — no Admin API keys)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_FOLDER=
